# 复制为 .env 后填写（不提交到仓库）

# ===== LLM（口播稿/文案/分镜）=====
# 任意 OpenAI 兼容接口都可以：DeepSeek / 硅基流动 / 通义 / 本地 Ollama
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
LLM_MODEL=deepseek-chat

# 也可以用提供商专属密钥（优先级高于 OPENAI_API_KEY）
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=sk-xxx    # OpenAI
# GROQ_API_KEY=             # Groq 免费

# 切换 LLM 提供商（对应 config/providers.yaml 里 llm 下的 key）
# LLM_PROVIDER=deepseek

# ===== 图片生成 =====
# 出图提供方：
#   placeholder  - 本地几何占位图，零依赖，免费
#   comfyui      - 本地 ComfyUI，免费（需显卡）
#   api          - 用 config/providers.yaml 里 image.default 指定的
#   siliconflow  - SiliconFlow Z-Image-Turbo，约0.10元/张
#   dalle3       - OpenAI DALL·E 3，约0.56元/张
IMAGE_PROVIDER=placeholder

# SiliconFlow（FLUX / SDXL）
SILICONFLOW_API_KEY=

# ComfyUI 本地
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_CHECKPOINT=

# ===== 网络代理 =====
# 海外数据源（Reddit/HackerNews）和发布走代理。国内源始终直连。
# 例：http://127.0.0.1:7890
# HTTP_PROXY=
# HTTPS_PROXY=
# BROWSER_PROXY=https://127.0.0.1:7890   # 浏览器专用，不填则用 HTTP_PROXY
